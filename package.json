{
  "name": "iris",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "iris": "scripts/iris.mjs"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/node24.mjs scripts/dev.mjs",
    "hydrate": "HOME=\"$PWD/.iris-package-home\" XDG_CACHE_HOME=\"$PWD/.iris-package-home/cache\" XDG_DATA_HOME=\"$PWD/.iris-package-home/data\" XDG_STATE_HOME=\"$PWD/.iris-package-home/state\" corepack pnpm install --frozen-lockfile",
    "runtime": "node scripts/node24.mjs --pnpm --filter @iris/runtime runtime",
    "iris": "node scripts/node24.mjs scripts/iris.mjs",
    "permission-smoke": "node scripts/node24.mjs scripts/permission-smoke.mjs",
    "test": "node scripts/node24.mjs scripts/mobile-contract.mjs test && node scripts/node24.mjs --pnpm --recursive --if-present test",
    "lint": "node scripts/node24.mjs --bin eslint .",
    "typecheck": "node scripts/node24.mjs scripts/mobile-contract.mjs typecheck && node scripts/node24.mjs --pnpm --recursive --if-present typecheck",
    "build": "node scripts/node24.mjs --pnpm --recursive --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
